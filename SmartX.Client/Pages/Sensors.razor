
@page "/sensors"
@using SmartX.Shared.Models
@using SmartX.Shared.Requests
@inject HttpClient Http

<PageTitle>Sensor Registration | Smart-X</PageTitle>

<div class="container py-4">
    <h1>Sensor Registration</h1>
    <p class="text-secondary">
        Register, configure and manage sensors in Smart-X.
    </p>

    <ExpandableSection Title="Register a Sensor">
        @if (!string.IsNullOrWhiteSpace(formMessage))
        {
            <div class="alert @formMessageClass" role="status">
                @formMessage
            </div>
        }

        <EditForm Model="@request"
                  OnValidSubmit="@RegisterSensorAsync"
                  @key="request">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <fieldset disabled="@isSaving">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label for="deviceIdentifier" class="form-label">
                            MAC address
                        </label>
                        <InputText id="deviceIdentifier"
                                   class="form-control"
                                   maxlength="17"
                                   placeholder="AA:BB:CC:DD:EE:FF"
                                   @bind-Value="request.DeviceIdentifier" />
                        <ValidationMessage For="@(() => request.DeviceIdentifier)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="deploymentLocation" class="form-label">
                            Deployment location
                        </label>
                        <InputText id="deploymentLocation"
                                   class="form-control"
                                   maxlength="200"
                                   @bind-Value="request.DeploymentLocation" />
                        <ValidationMessage For="@(() => request.DeploymentLocation)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="category" class="form-label">
                            Sensor category
                        </label>
                        <InputSelect id="category"
                                     class="form-select"
                                     @bind-Value="request.Category">
                            <option value="">Select a category</option>
                            @foreach (var category in Enum.GetValues<SensorCategory>())
                            {
                                <option value="@category">
                                    @CategoryLabel(category)
                                </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => request.Category)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="dataType" class="form-label">
                            Telemetry data type
                        </label>
                        <InputSelect id="dataType"
                                     class="form-select"
                                     @bind-Value="request.DataType">
                            <option value="">Select a data type</option>
                            @foreach (var dataType in Enum.GetValues<TelemetryDataType>())
                            {
                                <option value="@dataType">@dataType</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => request.DataType)" />
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            @(isSaving ? "Registering..." : "Register sensor")
                        </button>
                    </div>
                </div>
            </fieldset>
        </EditForm>
    </ExpandableSection>

    <ExpandableSection Title="Load Simulation Data">
        <DemoDataPanel IsBusy="@(isLoading || isSaving)"
                       OnLoaded="LoadSensorsAsync" />
    </ExpandableSection>

    <SensorDirectory Sensors="@sensors"
                     IsLoading="@isLoading"
                     IsBusy="@isSaving"
                     LoadError="@loadError"
                     OnRefresh="LoadSensorsAsync" />
</div>

@code {
    private RegisterSensorRequest request = new();
    private SensorProfile[] sensors = [];
    private bool isSaving;
    private bool isLoading;
    private string? formMessage;
    private string formMessageClass = "alert-info";
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorsAsync();
    }

    private async Task LoadSensorsAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        loadError = null;

        try
        {
            sensors = await Http.GetFromJsonAsync<SensorProfile[]>("api/sensors")
                ?? [];
        }
        catch (HttpRequestException)
        {
            loadError = "Could not refresh sensors. Check that the API is running. Any displayed rows may be out of date.";
        }
        catch (OperationCanceledException)
        {
            loadError = "Loading sensors timed out. Try refreshing again.";
        }
        catch (System.Text.Json.JsonException)
        {
            loadError = "The API returned an unreadable sensor list.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RegisterSensorAsync()
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;
        formMessage = null;
        formMessageClass = "alert-danger";

        try
        {
            using var response = await Http.PostAsJsonAsync(
                "api/sensors",
                request);

            if (!response.IsSuccessStatusCode)
            {
                formMessage = await ReadApiErrorAsync(response);
                return;
            }

            formMessageClass = "alert-success";
            formMessage = $"Sensor {request.DeviceIdentifier.Trim()} registered successfully.";
            request = new RegisterSensorRequest();

            await LoadSensorsAsync();
        }
        catch (HttpRequestException)
        {
            formMessage = "Could not confirm registration. Check the API connection and refresh the sensor list before retrying.";
        }
        catch (OperationCanceledException)
        {
            formMessage = "Registration timed out. Refresh the sensor list before retrying to check whether it was saved.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static async Task<string> ReadApiErrorAsync(
        HttpResponseMessage response)
    {
        var fallback = $"Registration failed with HTTP {(int)response.StatusCode}.";

        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ApiProblem>();

            if (problem?.Errors is { Count: > 0 })
            {
                return string.Join(
                    " ",
                    problem.Errors.Values.SelectMany(messages => messages));
            }

            return problem?.Detail ?? problem?.Title ?? fallback;
        }
        catch (System.Text.Json.JsonException)
        {
            return fallback;
        }
    }

    private static string CategoryLabel(SensorCategory category)
    {
        return category switch
        {
            SensorCategory.PowerConsumption => "Power consumption",
            _ => category.ToString()
        };
    }

    public sealed class ApiProblem
    {
        public string? Title { get; set; }
        public string? Detail { get; set; }
        public Dictionary<string, string[]>? Errors { get; set; }
    }
}
