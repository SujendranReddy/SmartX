@page "/network-topology"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@inject HttpClient Http

<PageTitle>Network Topology | Smart-X</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>Network Topology and Mesh Routing</h1>
            <p class="text-secondary mb-0">
                Monitor sensor connectivity, routing and network recovery.
            </p>
        </div>

        <button type="button"
                class="btn btn-outline-primary"
                disabled="@isLoading"
                @onclick="LoadTopologyAsync">
            @(isLoading ? "Refreshing..." : "Refresh Network")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (isLoading && topology is null)
    {
        <p role="status">Loading network topology...</p>
    }
    else if (topology is not null)
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h6 text-secondary">Total Network Nodes</h2>
                        <div class="fs-2 fw-bold">
                            @topology.Nodes.Length
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h6 text-secondary">Reachable Sensors</h2>
                        <div class="fs-2 fw-bold text-success">
                            @topology.Nodes.Count(node => !node.IsGateway && node.IsReachable)
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h6 text-secondary">MST Total Cost</h2>
                        <div class="fs-2 fw-bold">
                            @topology.SpanningTree.TotalCost.ToString("0.##", CultureInfo.InvariantCulture)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <section class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="h5 mb-1">Mesh Network Diagram</h2>
                        <p class="text-secondary mb-0">
                            Explore sensors and connections to the central gateway.
                        </p>
                    </div>
                    <span class="badge bg-secondary">
                        @filteredSensorCount matching sensors
                    </span>
                </div>

                <div class="row g-3 align-items-end mb-3">
                    <div class="col-12 col-lg-8">
                        <label for="sensorSearch"
                               class="form-label fw-semibold">
                            Search Sensors
                        </label>

                        <input id="sensorSearch"
                               type="search"
                               class="form-control"
                               placeholder="Search device identifier or deployment location"
                               value="@searchTerm"
                               @oninput="OnSearchInput" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <div class="d-flex justify-content-lg-end align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    disabled="@(currentPage == 0)"
                                    @onclick="PreviousPage">
                                Previous
                            </button>

                            <span class="small text-nowrap">
                                @(currentPage + 1) / @TotalPages
                            </span>

                            <button type="button"
                                    class="btn btn-outline-primary"
                                    disabled="@(currentPage >= TotalPages - 1)"
                                    @onclick="NextPage">
                                Next
                            </button>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3 mb-3">
                    <span class="small">
                        <span class="badge bg-primary">G</span>
                        Gateway
                    </span>

                    <span class="small">
                        <span class="badge bg-success">S</span>
                        Reachable
                    </span>

                    <span class="small">
                        <span class="badge bg-danger">S</span>
                        Unreachable
                    </span>

                    <span class="small text-success">
                        Green lines: MST
                    </span>

                    <span class="small text-secondary">
                        Grey lines: Other connections
                    </span>
                </div>

                <div class="alert alert-info py-2 mb-3">
                    @if (filteredSensorCount > 0)
                    {
                        <span>
                            Displaying sensors
                            @(currentPage * PageSize + 1) -
                            @(currentPage * PageSize + visibleSensors.Length)
                            of @filteredSensorCount
                        </span>
                    }
                    else
                    {
                        <span>No matching sensors</span>
                    }
                </div>

                <svg viewBox="0 0 800 430"
                     class="w-100 border rounded bg-light"
                     role="img"
                     aria-label="Mesh network diagram showing selected sensors and central gateway">

                    @foreach (var connection in topology.Connections)
                    {
                        if (positions.TryGetValue(connection.Source, out var source) &&
                            positions.TryGetValue(connection.Target, out var target))
                        {
                            <line x1="@source.X"
                                  y1="@source.Y"
                                  x2="@target.X"
                                  y2="@target.Y"
                                  stroke="#94a3b8"
                                  stroke-width="2" />
                        }
                    }

                    @foreach (var connection in topology.SpanningTree.Connections)
                    {
                        if (positions.TryGetValue(connection.Source, out var source) &&
                            positions.TryGetValue(connection.Target, out var target))
                        {
                            <line x1="@source.X"
                                  y1="@source.Y"
                                  x2="@target.X"
                                  y2="@target.Y"
                                  stroke="#198754"
                                  stroke-width="4"
                                  stroke-linecap="round" />

                            <rect x="@((source.X + target.X) / 2 - 22)"
                                  y="@((source.Y + target.Y) / 2 - 15)"
                                  width="44"
                                  height="28"
                                  rx="8"
                                  fill="#ffffff"
                                  stroke="#94a3b8"
                                  stroke-width="1" />

                            @(SvgLabel(
                                (source.X + target.X) / 2,
                                (source.Y + target.Y) / 2 + 4,
                                connection.Cost.ToString("0.##", CultureInfo.InvariantCulture),
                                14,
                                "#166534"))
                        }
                    }

                    <circle cx="400"
                            cy="210"
                            r="28"
                            fill="#1d4ed8"
                            stroke="white"
                            stroke-width="3" />

                    @(SvgLabel(400, 215, "G", 17, "#ffffff"))
                    @(SvgLabel(400, 256, "GATEWAY", 14, "#212529"))

                    @for (var i = 0; i < visibleSensors.Length; i++)
                    {
                        var sensor = visibleSensors[i];

                        if (positions.TryGetValue(sensor.Id, out var position))
                        {
                            <circle cx="@position.X"
                                    cy="@position.Y"
                                    r="24"
                                    fill="@(sensor.IsReachable ? "#198754" : "#dc3545")"
                                    stroke="white"
                                    stroke-width="3" />

                            @(SvgLabel(
                                position.X,
                                position.Y + 5,
                                $"S{currentPage * PageSize + i + 1}",
                                14,
                                "#ffffff"))
                        }
                    }
                </svg>

                @if (filteredSensorCount == 0)
                {
                    <div class="alert alert-info mt-3">
                        No sensors match your search.
                    </div>
                }

                <p class="small text-secondary mt-3 mb-0">
                    The diagram displays eight sensors per page.
                    Full network calculations include all registered sensors.
                    Only connections between visible nodes are drawn.
                </p>
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                    <div>
                        <h2 class="h5 mb-1">Selected Sensor Connections</h2>
                        <p class="text-secondary mb-0">
                            View direct connections, including sensors on other pages.
                        </p>
                    </div>
                    <div>
                        <label for="focusedSensor" class="form-label fw-semibold">Select Sensor</label>
                        <select id="focusedSensor"
                                class="form-select"
                                value="@focusedSensorId"
                                disabled="@(visibleSensors.Length == 0)"
                                @onchange="OnFocusedSensorChanged">
                            @foreach (var sensor in visibleSensors)
                            {
                                <option value="@sensor.Id">@sensor.Id</option>
                            }
                        </select>
                    </div>
                </div>

                @if (string.IsNullOrWhiteSpace(focusedSensorId))
                {
                    <p class="text-secondary mb-0">No sensor selected.</p>
                }
                else
                {
                    var shownConnections = focusedConnections
                        .Skip(focusedPage * FocusedPageSize)
                        .Take(FocusedPageSize)
                        .ToArray();
                    var selectedNode = topology.Nodes.FirstOrDefault(node =>
                        string.Equals(node.Id, focusedSensorId, StringComparison.OrdinalIgnoreCase));

                    <p class="small text-secondary mb-2">
                        Selected: <strong>@focusedSensorId</strong> · @focusedConnections.Length direct connections
                    </p>

                    <svg viewBox="0 0 800 330"
                         class="w-100 border rounded bg-light"
                         role="img"
                         aria-label="Direct network connections for the selected sensor">
                        @for (var i = 0; i < shownConnections.Length; i++)
                        {
                            var connection = shownConnections[i];
                            var neighborId = GetFocusedNeighborId(connection);
                            var neighbor = topology.Nodes.FirstOrDefault(node =>
                                string.Equals(node.Id, neighborId, StringComparison.OrdinalIgnoreCase));
                            var isGateway = string.Equals(neighborId, topology.GatewayId,
                                StringComparison.OrdinalIgnoreCase);
                            var point = FocusedNodePosition(i);
                            var labelX = (400 + point.X) / 2;
                            var labelY = (165 + point.Y) / 2;

                            <line x1="400" y1="165" x2="@point.X" y2="@point.Y"
                                  stroke="#64748b" stroke-width="3" stroke-linecap="round" />
                            <rect x="@(labelX - 22)" y="@(labelY - 15)"
                                  width="44" height="28" rx="8"
                                  fill="#ffffff" stroke="#94a3b8" stroke-width="1" />
                            @(SvgLabel(labelX, labelY + 4,
                                connection.Cost.ToString("0.##", CultureInfo.InvariantCulture),
                                14, "#334155"))
                            <circle cx="@point.X" cy="@point.Y" r="25"
                                    fill="@(isGateway ? "#1d4ed8" : neighbor?.IsReachable == true ? "#198754" : "#dc3545")"
                                    stroke="#ffffff" stroke-width="3" />
                            @(SvgLabel(point.X, point.Y + 5,
                                isGateway ? "G" : $"N{i + 1}", 15, "#ffffff"))
                        }

                        <circle cx="400" cy="165" r="30"
                                fill="@(selectedNode?.IsReachable == true ? "#198754" : "#dc3545")"
                                stroke="#ffffff" stroke-width="4" />
                        @(SvgLabel(400, 171, "S", 18, "#ffffff"))
                    </svg>

                    @if (shownConnections.Length == 0)
                    {
                        <p class="small text-secondary mt-3 mb-0">This sensor has no direct connections.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @for (var i = 0; i < shownConnections.Length; i++)
                            {
                                var connection = shownConnections[i];
                                var neighborId = GetFocusedNeighborId(connection);
                                var isGateway = string.Equals(neighborId, topology.GatewayId,
                                    StringComparison.OrdinalIgnoreCase);
                                var label = isGateway ? "G" : $"N{i + 1}";

                                <span class="badge bg-light text-dark border p-2">
                                    <strong>@label</strong>: @neighborId (cost @connection.Cost.ToString("0.##", CultureInfo.InvariantCulture))
                                </span>
                            }
                        </div>
                    }

                    @if (FocusedTotalPages > 1)
                    {
                        <div class="d-flex justify-content-end align-items-center gap-2 mt-3">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    disabled="@(focusedPage == 0)" @onclick="PreviousFocusedPage">
                                Previous
                            </button>
                            <span class="small">@(focusedPage + 1) / @FocusedTotalPages</span>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    disabled="@(focusedPage >= FocusedTotalPages - 1)" @onclick="NextFocusedPage">
                                Next
                            </button>
                        </div>
                    }
                }
            </div>
        </section>

        <h2 class="h5 mb-3">Network Tools</h2>

        <ExpandableSection Title="Manage Network Connections">
            <MeshConnectionManager
                NodeIds="@topology.Nodes.Select(node => node.Id).ToArray()"
                OnConnectionSaved="LoadTopologyAsync" />
        </ExpandableSection>

        <ExpandableSection Title="Inspect Sensor Routing">
            <MeshRouteInspector
                SensorIds="@topology.Nodes.Where(node => !node.IsGateway).Select(node => node.Id).ToArray()" />
        </ExpandableSection>

        <ExpandableSection Title="Sensor Failure Simulation">
            <MeshFailureControls
                SensorIds="@topology.Nodes.Where(node => !node.IsGateway).Select(node => node.Id).ToArray()"
                OnAvailabilityChanged="LoadTopologyAsync" />
        </ExpandableSection>

        <ExpandableSection Title="Displayed Network Nodes">
            <p class="text-secondary">
                Sensor labels correspond to the nodes shown in the diagram.
            </p>

            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Diagram Label</th>
                            <th scope="col">Device Identifier</th>
                            <th scope="col">Location</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <span class="badge bg-primary">G</span>
                            </td>
                            <td>@topology.GatewayId</td>
                            <td>Central Gateway</td>
                            <td>
                                <span class="badge bg-success">Reachable</span>
                            </td>
                        </tr>

                        @for (var i = 0; i < visibleSensors.Length; i++)
                        {
                            var sensor = visibleSensors[i];

                            <tr>
                                <td>
                                    <strong>
                                        @($"S{currentPage * PageSize + i + 1}")
                                    </strong>
                                </td>
                                <td>@sensor.Id</td>
                                <td>@sensor.DeploymentLocation</td>
                                <td>
                                    @if (sensor.IsReachable)
                                    {
                                        <span class="badge bg-success">
                                            Reachable
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Unreachable
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (filteredSensorCount > 0)
            {
                <p class="small text-secondary mb-0">
                    Showing sensors
                    @(currentPage * PageSize + 1)
                    to
                    @(currentPage * PageSize + visibleSensors.Length)
                    of @filteredSensorCount matching sensors.
                </p>
            }
        </ExpandableSection>

        <ExpandableSection Title="Minimum Spanning Tree Details">
            <p class="text-secondary">
                Prim's algorithm calculates a minimum-cost connection tree
                for sensors reachable from the gateway.
            </p>

            @if (topology.SpanningTree.Connections.Length == 0)
            {
                <div class="alert alert-info">
                    No reachable sensor connections are available.
                    Create connections to begin mesh routing.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">From</th>
                                <th scope="col">To</th>
                                <th scope="col">Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var connection in topology.SpanningTree.Connections.Take(20))
                            {
                                <tr>
                                    <td>@connection.Source</td>
                                    <td>@connection.Target</td>
                                    <td>
                                        @connection.Cost.ToString("0.##", CultureInfo.InvariantCulture)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (topology.SpanningTree.Connections.Length > 20)
                {
                    <p class="small text-secondary">
                        Showing the first 20 of
                        @topology.SpanningTree.Connections.Length
                        MST connections.
                    </p>
                }
            }

            <p class="fw-semibold mb-0">
                Full Network MST Cost:
                @topology.SpanningTree.TotalCost.ToString("0.##", CultureInfo.InvariantCulture)
            </p>
        </ExpandableSection>
    }
</div>

@code {
    private const int PageSize = 8;
    private const int FocusedPageSize = 6;

    private MeshTopologyResponse? topology;
    private MeshTopologyNode[] visibleSensors = [];
    private string? focusedSensorId;
    private MeshConnection[] focusedConnections = [];
    private int focusedPage;

    private Dictionary<string, NodePosition> positions =
        new(StringComparer.OrdinalIgnoreCase);

    private string searchTerm = string.Empty;
    private string? errorMessage;

    private int currentPage;
    private int filteredSensorCount;

    private bool isLoading;

    private int TotalPages =>
        Math.Max(1, (filteredSensorCount + PageSize - 1) / PageSize);

    private int FocusedTotalPages =>
        Math.Max(1, (focusedConnections.Length + FocusedPageSize - 1) / FocusedPageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadTopologyAsync();
    }

    private async Task LoadTopologyAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await Http.GetFromJsonAsync<MeshTopologyResponse>(
                "api/mesh/topology");

            if (result is null)
            {
                throw new JsonException("The topology response was empty.");
            }

            topology = result;
            UpdateVisibleNodes();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to load network topology. Check the API connection.";
        }
        catch (OperationCanceledException)
        {
            errorMessage = "The network request timed out.";
        }
        catch (JsonException)
        {
            errorMessage = "The API returned invalid network information.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        currentPage = 0;
        UpdateVisibleNodes();
    }

    private void PreviousPage()
    {
        if (currentPage > 0)
        {
            currentPage--;
            UpdateVisibleNodes();
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages - 1)
        {
            currentPage++;
            UpdateVisibleNodes();
        }
    }

    private void UpdateVisibleNodes()
    {
        if (topology is null)
        {
            return;
        }

        var filter = searchTerm.Trim();

        var filtered = topology.Nodes
            .Where(node => !node.IsGateway)
            .Where(node =>
                string.IsNullOrEmpty(filter) ||
                node.Id.Contains(
                    filter,
                    StringComparison.OrdinalIgnoreCase) ||
                node.DeploymentLocation.Contains(
                    filter,
                    StringComparison.OrdinalIgnoreCase))
            .OrderBy(
                node => node.Id,
                StringComparer.OrdinalIgnoreCase)
            .ToArray();

        filteredSensorCount = filtered.Length;

        currentPage = Math.Clamp(
            currentPage,
            0,
            TotalPages - 1);

        visibleSensors = filtered
            .Skip(currentPage * PageSize)
            .Take(PageSize)
            .ToArray();

        CalculatePositions();

        if (!visibleSensors.Any(node => string.Equals(
                node.Id, focusedSensorId, StringComparison.OrdinalIgnoreCase)))
        {
            focusedSensorId = visibleSensors.FirstOrDefault()?.Id;
            focusedPage = 0;
        }

        UpdateFocusedConnections();
    }

    private void CalculatePositions()
    {
        positions = new Dictionary<string, NodePosition>(
            StringComparer.OrdinalIgnoreCase)
        {
            [topology!.GatewayId] = new NodePosition(400, 210)
        };

        for (var i = 0; i < visibleSensors.Length; i++)
        {
            var angle =
                (2 * Math.PI * i / visibleSensors.Length) - Math.PI / 2;

            var x = 400 + (int)Math.Round(
                Math.Cos(angle) * 280);

            var y = 210 + (int)Math.Round(
                Math.Sin(angle) * 150);

            positions[visibleSensors[i].Id] = new NodePosition(x, y);
        }
    }

    private void OnFocusedSensorChanged(ChangeEventArgs args)
    {
        focusedSensorId = args.Value?.ToString();
        focusedPage = 0;
        UpdateFocusedConnections();
    }

    private void PreviousFocusedPage()
    {
        if (focusedPage > 0)
        {
            focusedPage--;
        }
    }

    private void NextFocusedPage()
    {
        if (focusedPage < FocusedTotalPages - 1)
        {
            focusedPage++;
        }
    }

    private void UpdateFocusedConnections()
    {
        if (topology is null || string.IsNullOrWhiteSpace(focusedSensorId))
        {
            focusedConnections = [];
            focusedPage = 0;
            return;
        }
        // include connections to sensors on other pages
        focusedConnections = topology.Connections
            .Where(connection =>
                string.Equals(connection.Source, focusedSensorId, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(connection.Target, focusedSensorId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(connection =>
                string.Equals(GetFocusedNeighborId(connection), topology.GatewayId,
                    StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(connection => GetFocusedNeighborId(connection),
                StringComparer.OrdinalIgnoreCase)
            .ToArray();

        focusedPage = Math.Clamp(focusedPage, 0, FocusedTotalPages - 1);
    }

    private string GetFocusedNeighborId(MeshConnection connection) =>
        string.Equals(connection.Source, focusedSensorId, StringComparison.OrdinalIgnoreCase)
            ? connection.Target
            : connection.Source;

    private static NodePosition FocusedNodePosition(int index) =>
        new(index % 2 == 0 ? 170 : 630, 75 + index / 2 * 90);

    private static RenderFragment SvgLabel(
        int x,
        int y,
        string value,
        int fontSize,
        string color) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "x", x);
        builder.AddAttribute(2, "y", y);
        builder.AddAttribute(3, "font-size", fontSize);
        builder.AddAttribute(4, "font-weight", "bold");
        builder.AddAttribute(5, "fill", color);
        builder.AddAttribute(6, "text-anchor", "middle");
        builder.AddContent(7, value);
        builder.CloseElement();
    };

    private sealed record NodePosition(int X, int Y);

    public sealed class MeshTopologyResponse
    {
        public string GatewayId { get; set; } = string.Empty;
        public MeshTopologyNode[] Nodes { get; set; } = [];
        public MeshConnection[] Connections { get; set; } = [];
        public MeshSpanningTree SpanningTree { get; set; } = new();
    }

    public sealed class MeshTopologyNode
    {
        public string Id { get; set; } = string.Empty;
        public string DeploymentLocation { get; set; } = string.Empty;
        public bool IsGateway { get; set; }
        public bool IsReachable { get; set; }
    }

    public sealed class MeshConnection
    {
        public string Source { get; set; } = string.Empty;
        public string Target { get; set; } = string.Empty;
        public double Cost { get; set; }
    }

    public sealed class MeshSpanningTree
    {
        public MeshConnection[] Connections { get; set; } = [];
        public double TotalCost { get; set; }
    }
}
