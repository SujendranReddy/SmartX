@page "/sensors/{SensorId:guid}/attachments"
@using SmartX.Shared.Models
@inject HttpClient Http

<PageTitle>Sensor Attachments | Smart-X</PageTitle>

<div class="container py-4">
    <a href="sensors" class="btn btn-outline-secondary mb-3">
        Back to sensors
    </a>

    <h1>Sensor Attachments</h1>

    @if (isLoadingSensor)
    {
        <p role="status">Loading sensor...</p>
    }
    else if (sensor is null)
    {
        <div class="alert alert-danger" role="alert">
            @sensorError
        </div>
    }
    else
    {
        <p class="text-secondary">
            <strong>@sensor.DeviceIdentifier</strong>
            · @sensor.DeploymentLocation
        </p>

        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h5">Upload an attachment</h2>

                <p id="attachmentHelp" class="text-secondary">
                    Choose a configuration file, photo or log.
                    Maximum size: 5 MiB.
                    Supported extensions: JSON, XML, YAML, YML, TXT,
                    CSV, LOG, JPG, JPEG, PNG and PDF.
                </p>

                @if (!string.IsNullOrWhiteSpace(uploadMessage))
                {
                    <div class="alert @uploadMessageClass" role="status">
                        @uploadMessage
                    </div>
                }

                <div class="mb-3">
                    <label for="attachmentFile" class="form-label">
                        Attachment
                    </label>
                    <InputFile id="attachmentFile"
                               class="form-control"
                               accept=".json,.xml,.yaml,.yml,.txt,.csv,.log,.jpg,.jpeg,.png,.pdf"
                               aria-describedby="attachmentHelp"
                               disabled="@isUploading"
                               OnChange="SelectFile"
                               @key="fileInputVersion" />
                </div>

                @if (selectedFile is not null)
                {
                    <p>
                        Selected: <strong>@selectedFile.Name</strong>
                        (@FormatSize(selectedFile.Size))
                    </p>
                }

                <button type="button"
                        class="btn btn-primary"
                        disabled="@(selectedFile is null || isUploading)"
                        @onclick="UploadAsync">
                    @(isUploading ? "Uploading..." : "Upload attachment")
                </button>
            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h5 mb-0">
                        Attachments (@attachments.Length)
                    </h2>
                    <button type="button"
                            class="btn btn-outline-primary"
                            disabled="@(isLoadingAttachments || isUploading)"
                            @onclick="LoadAttachmentsAsync">
                        @(isLoadingAttachments ? "Loading..." : "Refresh attachments")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(listError))
                {
                    <div class="alert alert-warning" role="alert">
                        @listError
                    </div>
                }

                @if (isLoadingAttachments)
                {
                    <p role="status">Loading attachments...</p>
                }
                else if (attachments.Length == 0 && string.IsNullOrWhiteSpace(listError))
                {
                    <p class="text-secondary mb-0">
                        No attachments yet. Upload the first file above.
                    </p>
                }

                @if (attachments.Length > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <caption>Files attached to this sensor, newest first.</caption>
                            <thead>
                                <tr>
                                    <th scope="col">File</th>
                                    <th scope="col">Size</th>
                                    <th scope="col">Uploaded (UTC)</th>
                                    <th scope="col">Download</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var attachment in attachments)
                                {
                                    <tr @key="attachment.Id">
                                        <td>@attachment.FileName</td>
                                        <td>@FormatSize(attachment.SizeBytes)</td>
                                        <td>@attachment.UploadedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="@DownloadUrl(attachment.Id)">
                                                Download
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public Guid SensorId { get; set; }

    private const long MaxFileSize = 5 * 1024 * 1024;

    private SensorProfile? sensor;
    private SensorAttachment[] attachments = [];
    private IBrowserFile? selectedFile;
    private int fileInputVersion;
    private bool isLoadingSensor;
    private bool isLoadingAttachments;
    private bool isUploading;
    private string? sensorError;
    private string? listError;
    private string? uploadMessage;
    private string uploadMessageClass = "alert-info";

    protected override async Task OnParametersSetAsync()
    {
        isLoadingSensor = true;
        sensor = null;
        attachments = [];
        selectedFile = null;
        sensorError = null;
        listError = null;
        uploadMessage = null;
        fileInputVersion++;

        try
        {
            sensor = await Http.GetFromJsonAsync<SensorProfile>(
                $"api/sensors/{SensorId}");

            if (sensor is null)
            {
                sensorError = "The API returned no sensor details.";
                return;
            }

            await LoadAttachmentsAsync();
        }
        catch (HttpRequestException exception)
        {
            sensorError = exception.StatusCode == System.Net.HttpStatusCode.NotFound
                ? "This sensor no longer exists. Return to the sensor list and refresh it."
                : "Could not load the sensor. Check the API connection and reload this page.";
        }
        catch (OperationCanceledException)
        {
            sensorError = "Loading the sensor timed out. Reload this page to try again.";
        }
        catch (System.Text.Json.JsonException)
        {
            sensorError = "The API returned unreadable sensor details.";
        }
        finally
        {
            isLoadingSensor = false;
        }
    }

    private void SelectFile(InputFileChangeEventArgs args)
    {
        selectedFile = null;
        uploadMessage = null;
        uploadMessageClass = "alert-danger";

        var file = args.File;

        if (file.Size == 0)
        {
            uploadMessage = "Select a file that contains data.";
            return;
        }

        if (file.Size > MaxFileSize)
        {
            uploadMessage = "The attachment must be 5 MiB or smaller.";
            return;
        }

        selectedFile = file;
    }

    private async Task LoadAttachmentsAsync()
    {
        if (sensor is null || isLoadingAttachments)
        {
            return;
        }

        isLoadingAttachments = true;
        listError = null;

        try
        {
            attachments = await Http.GetFromJsonAsync<SensorAttachment[]>(
                $"api/sensors/{SensorId}/attachments") ?? [];
        }
        catch (HttpRequestException exception)
        {
            listError = exception.StatusCode == System.Net.HttpStatusCode.NotFound
                ? "This sensor no longer exists. Return to the sensor list and refresh it."
                : "Could not refresh attachments. Check the API connection. Any displayed files may be out of date.";
        }
        catch (OperationCanceledException)
        {
            listError = "Loading attachments timed out. Try refreshing again.";
        }
        catch (System.Text.Json.JsonException)
        {
            listError = "The API returned an unreadable attachment list.";
        }
        finally
        {
            isLoadingAttachments = false;
        }
    }

    // limit file size
    // & checking in API
    private async Task UploadAsync()
    {
        if (selectedFile is null || sensor is null || isUploading)
        {
            return;
        }

        isUploading = true;
        uploadMessage = null;
        uploadMessageClass = "alert-danger";

        try
        {
            var file = selectedFile;

            await using var stream = file.OpenReadStream(MaxFileSize);
            using var multipart = new MultipartFormDataContent();

            using var fileContent = new StreamContent(stream);
            var browserContentType = string.IsNullOrWhiteSpace(file.ContentType)
                ? "application/octet-stream"
                : file.ContentType;
            fileContent.Headers.ContentType =
                System.Net.Http.Headers.MediaTypeHeaderValue.Parse(browserContentType);

            multipart.Add(
                fileContent,
                "file",
                file.Name);

            using var response = await Http.PostAsync(
                $"api/sensors/{SensorId}/attachments",
                multipart);

            if (!response.IsSuccessStatusCode)
            {
                uploadMessage = await ReadUploadErrorAsync(response);
                return;
            }

            uploadMessageClass = "alert-success";
            uploadMessage = $"{file.Name} uploaded successfully.";
            selectedFile = null;
            fileInputVersion++;

            await LoadAttachmentsAsync();
        }
        catch (HttpRequestException)
        {
            uploadMessage = "Could not confirm the upload. Check the API connection and refresh attachments before retrying.";
        }
        catch (OperationCanceledException)
        {
            uploadMessage = "The upload timed out. Refresh attachments before retrying to check whether the file was saved.";
        }
        catch (IOException)
        {
            uploadMessage = "Could not read the selected file. Select it again and retry.";
        }
        finally
        {
            isUploading = false;
        }
    }

    private static async Task<string> ReadUploadErrorAsync(
        HttpResponseMessage response)
    {
        var fallback = $"Upload failed with HTTP {(int)response.StatusCode}.";

        try
        {
            var problem = await response.Content.ReadFromJsonAsync<UploadProblem>();

            return problem?.Detail ?? problem?.Title ?? fallback;
        }
        catch (System.Text.Json.JsonException)
        {
            return fallback;
        }
    }

    private string DownloadUrl(Guid attachmentId)
    {
        return new Uri(
            Http.BaseAddress!,
            $"api/sensors/{SensorId}/attachments/{attachmentId}")
            .AbsoluteUri;
    }

    private static string FormatSize(long bytes)
    {
        return bytes < 1024
            ? $"{bytes} B"
            : $"{bytes / 1024d:N1} KiB";
    }

    public sealed class UploadProblem
    {
        public string? Title { get; set; }

        public string? Detail { get; set; }
    }
}