@using System.Globalization
@using SmartX.Shared.Models
@inject HttpClient Http

<section class="card mt-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Daily telemetry history</h2>
            <button type="button"
                    class="btn btn-outline-primary"
                    disabled="@isLoading"
                    @onclick="LoadDailyHistoryAsync">
                @(isLoading ? "Loading..." : "Refresh daily history")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-warning" role="alert">
                @errorMessage
            </div>
        }

        @if (isLoading)
        {
            <p role="status">Loading daily history...</p>
        }
        else if (days.Length == 0 && string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="text-secondary mb-0">
                No daily history yet. Submit a reading above.
            </p>
        }

        @if (days.Length > 0)
        {
            <p class="text-secondary">
                @days.Length recorded day(s)
                · @days.Sum(day => day.Readings.Length) total readings
            </p>

            <div class="mb-3">
                <label for="historyDate" class="form-label">
                    Date (UTC)
                </label>

                <select id="historyDate"
                        class="form-select"
                        disabled="@isLoading"
                        @bind="selectedDate">
                    @foreach (var day in days)
                    {
                        <option value="@DateKey(day.Date)">
                            @DateKey(day.Date) — @day.Readings.Length reading(s)
                        </option>
                    }
                </select>
            </div>

            @if (SelectedDay is { } selectedDay)
            {
                var chart = BuildChart(selectedDay.Readings);

                <p role="status">
                    Showing @selectedDay.Readings.Length reading(s)
                    for @DateKey(selectedDay.Date).
                </p>

                <div class="card mb-4">
                    <div class="card-body">
                        <h3 class="h6">Telemetry Timeline</h3>

                        <p class="text-secondary small">
                            Sensor readings arranged from earliest to latest.
                            Times are shown in UTC.
                        </p>

                        @if (chart is null)
                        {
                            <p class="text-secondary">
                                No readings available to plot for this date.
                            </p>
                        }
                        else
                        {
                            <div class="w-100">
                                <svg viewBox="0 0 800 270"
                                     class="w-100"
                                     style="max-height: 320px;"
                                     role="img"
                                     aria-label="Timeline of telemetry readings">

                                    <title>Daily telemetry timeline</title>

                                    <line x1="70" y1="25"
                                          x2="70" y2="220"
                                          stroke="currentColor"
                                          stroke-width="1" />

                                    <line x1="70" y1="220"
                                          x2="750" y2="220"
                                          stroke="currentColor"
                                          stroke-width="1" />

                                    <line x1="70" y1="25"
                                          x2="750" y2="25"
                                          stroke="currentColor"
                                          stroke-opacity="0.2"
                                          stroke-dasharray="4 4" />

                                    <line x1="70" y1="122.5"
                                          x2="750" y2="122.5"
                                          stroke="currentColor"
                                          stroke-opacity="0.2"
                                          stroke-dasharray="4 4" />

                                    <text x="62" y="30"
                                          font-size="14"
                                          text-anchor="end"
                                          fill="currentColor">
                                        @chart.TopLabel
                                    </text>

                                    <text x="62" y="127"
                                          font-size="14"
                                          text-anchor="end"
                                          fill="currentColor">
                                        @chart.MiddleLabel
                                    </text>

                                    <text x="62" y="225"
                                          font-size="14"
                                          text-anchor="end"
                                          fill="currentColor">
                                        @chart.BottomLabel
                                    </text>

                                    <polyline points="@chart.Line"
                                              fill="none"
                                              stroke="currentColor"
                                              class="text-primary"
                                              stroke-width="3"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />

                                    @foreach (var point in chart.Points)
                                    {
                                        <circle cx="@point.X"
                                                cy="@point.Y"
                                                r="5"
                                                fill="currentColor"
                                                class="text-primary">
                                            <title>@point.Tooltip</title>
                                        </circle>
                                    }

                                    <text x="70" y="245"
                                          font-size="13"
                                          text-anchor="start"
                                          fill="currentColor">
                                        @chart.StartTime
                                    </text>

                                    <text x="750" y="245"
                                          font-size="13"
                                          text-anchor="end"
                                          fill="currentColor">
                                        @chart.EndTime
                                    </text>
                                </svg>
                            </div>

                            <p class="text-secondary small mb-0">
                                @chart.Points.Length readings plotted.
                                @(DataType == TelemetryDataType.Boolean
                                    ? "ON = 1, OFF = 0."
                                    : "Values use the sensor's configured telemetry type.")
                            </p>
                        }
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <caption>
                            Readings for the selected UTC date, newest first.
                        </caption>
                        <thead>
                            <tr>
                                <th scope="col">Value</th>
                                <th scope="col">Recorded (UTC)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reading in selectedDay.Readings)
                            {
                                <tr>
                                    <td>@reading.Value</td>
                                    <td>
                                        @reading.RecordedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss.fff")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</section>

@code {
    [Parameter]
    public Guid SensorId { get; set; }

    [Parameter]
    public TelemetryDataType DataType { get; set; }

    [Parameter]
    public int RefreshVersion { get; set; }

    private DailyRow[] days = [];
    private string selectedDate = string.Empty;
    private string? errorMessage;
    private bool isLoading;
    private Guid? loadedSensorId;
    private TelemetryDataType? loadedDataType;
    private int loadedRefreshVersion = -1;
    private int requestVersion;

    private DailyRow? SelectedDay => days.FirstOrDefault(
        day => DateKey(day.Date) == selectedDate);

    protected override async Task OnParametersSetAsync()
    {
        var sensorChanged =
            loadedSensorId != SensorId ||
            loadedDataType != DataType;

        if (!sensorChanged &&
            loadedRefreshVersion == RefreshVersion)
        {
            return;
        }

        loadedSensorId = SensorId;
        loadedDataType = DataType;
        loadedRefreshVersion = RefreshVersion;

        if (sensorChanged)
        {
            days = [];
            selectedDate = string.Empty;
        }

        await LoadDailyHistoryAsync();
    }

    private async Task LoadDailyHistoryAsync()
    {
        var currentRequest = ++requestVersion;
        var currentSensorId = SensorId;
        var currentDataType = DataType;

        isLoading = true;
        errorMessage = null;

        try
        {
            var result = currentDataType switch
            {
                TelemetryDataType.Float =>
                    await ReadDailyHistoryAsync<float>(
                        currentSensorId, "float"),

                TelemetryDataType.Integer =>
                    await ReadDailyHistoryAsync<int>(
                        currentSensorId, "integer"),

                TelemetryDataType.Boolean =>
                    await ReadDailyHistoryAsync<bool>(
                        currentSensorId, "boolean"),

                _ => throw new System.Text.Json.JsonException(
                    "Unsupported telemetry data type.")
            };

            if (currentRequest != requestVersion)
            {
                return;
            }

            days = result;

            if (!days.Any(day => DateKey(day.Date) == selectedDate))
            {
                selectedDate = days.Length > 0
                    ? DateKey(days[0].Date)
                    : string.Empty;
            }
        }
        catch (HttpRequestException exception)
        {
            if (currentRequest == requestVersion)
            {
                errorMessage =
                    exception.StatusCode ==
                    System.Net.HttpStatusCode.NotFound
                    ? "This sensor no longer exists. Return to the sensor list and refresh it."
                    : "Could not refresh daily history. Check the API connection. Any displayed readings may be out of date.";
            }
        }
        catch (OperationCanceledException)
        {
            if (currentRequest == requestVersion)
            {
                errorMessage =
                    "Loading daily history timed out. Try refreshing again.";
            }
        }
        catch (System.Text.Json.JsonException)
        {
            if (currentRequest == requestVersion)
            {
                errorMessage =
                    "The API returned unreadable daily history.";
            }
        }
        finally
        {
            if (currentRequest == requestVersion)
            {
                isLoading = false;
            }
        }
    }

    private async Task<DailyRow[]> ReadDailyHistoryAsync<T>(
        Guid sensorId,
        string route) where T : struct
    {
        var result =
            await Http.GetFromJsonAsync<DailyTelemetryHistory<T>>(
                $"api/sensors/{sensorId}/telemetry/{route}/daily");

        if (result is null ||
            result.Dates is null ||
            result.Readings is null ||
            result.Dates.Length != result.Readings.Length ||
            result.Readings.Any(row => row is null))
        {
            throw new System.Text.Json.JsonException(
                "Daily history contains invalid date or reading arrays.");
        }

        return result.Dates
            .Select((date, index) => new DailyRow(
                date,
                result.Readings[index]
                    .OrderByDescending(packet => packet.RecordedAtUtc)
                    .Select(packet => new ReadingRow(
                        Convert.ToString(
                            packet.Value,
                            CultureInfo.InvariantCulture) ?? string.Empty,
                        packet.RecordedAtUtc))
                    .ToArray()))
            .OrderByDescending(day => day.Date)
            .ToArray();
    }

    private TimelineChart? BuildChart(ReadingRow[] readings)
    {
        var samples = new List<ChartSample>();

        foreach (var reading in readings)
        {
            var numericValue = ParseChartValue(reading.Value);

            if (numericValue.HasValue)
            {
                samples.Add(new ChartSample(
                    reading.RecordedAtUtc,
                    numericValue.Value,
                    reading.Value));
            }
        }

        samples = samples
            .OrderBy(sample => sample.RecordedAtUtc)
            .ToList();

        if (samples.Count == 0)
        {
            return null;
        }

        var minimum = samples.Min(sample => sample.NumericValue);
        var maximum = samples.Max(sample => sample.NumericValue);

        if (DataType == TelemetryDataType.Boolean)
        {
            minimum = 0;
            maximum = 1;
        }
        else
        {
            var range = maximum - minimum;
            var padding = range == 0
                ? Math.Max(1, Math.Abs(maximum) * 0.1)
                : range * 0.1;

            minimum -= padding;
            maximum += padding;
        }

        const double left = 70;
        const double right = 750;
        const double top = 25;
        const double bottom = 220;

        var firstTime = samples[0].RecordedAtUtc;
        var lastTime = samples[^1].RecordedAtUtc;

        var duration = (lastTime - firstTime).TotalSeconds;

        var points = new List<TimelinePoint>();

        foreach (var sample in samples)
        {
            var x = duration <= 0
                ? (left + right) / 2
                : left +
                    (sample.RecordedAtUtc - firstTime).TotalSeconds /
                    duration * (right - left);

            var y = bottom -
                (sample.NumericValue - minimum) /
                (maximum - minimum) * (bottom - top);

            var tooltip =
                $"{sample.RecordedAtUtc.UtcDateTime:yyyy-MM-dd HH:mm:ss} UTC: {sample.DisplayValue}";

            points.Add(new TimelinePoint(
                x.ToString("0.##", CultureInfo.InvariantCulture),
                y.ToString("0.##", CultureInfo.InvariantCulture),
                tooltip));
        }

        var line = string.Join(
            " ",
            points.Select(point => $"{point.X},{point.Y}"));

        var topLabel = DataType == TelemetryDataType.Boolean
            ? "ON"
            : FormatNumber(maximum);

        var middleLabel = DataType == TelemetryDataType.Boolean
            ? ""
            : FormatNumber((minimum + maximum) / 2);

        var bottomLabel = DataType == TelemetryDataType.Boolean
            ? "OFF"
            : FormatNumber(minimum);

        return new TimelineChart(
            points.ToArray(),
            line,
            topLabel,
            middleLabel,
            bottomLabel,
            firstTime.UtcDateTime.ToString("HH:mm:ss"),
            lastTime.UtcDateTime.ToString("HH:mm:ss"));
    }

    private double? ParseChartValue(string value)
    {
        if (DataType == TelemetryDataType.Boolean)
        {
            return bool.TryParse(value, out var booleanValue)
                ? (booleanValue ? 1.0 : 0.0)
                : null;
        }

        return double.TryParse(
            value,
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out var numericValue) &&
            double.IsFinite(numericValue)
            ? numericValue
            : null;
    }

    private static string FormatNumber(double value)
    {
        return value.ToString("0.###", CultureInfo.InvariantCulture);
    }

    private static string DateKey(DateOnly date)
    {
        return date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private sealed record DailyRow(
        DateOnly Date,
        ReadingRow[] Readings);

    private sealed record ReadingRow(
        string Value,
        DateTimeOffset RecordedAtUtc);

    private sealed record ChartSample(
        DateTimeOffset RecordedAtUtc,
        double NumericValue,
        string DisplayValue);

    private sealed record TimelinePoint(
        string X,
        string Y,
        string Tooltip);

    private sealed record TimelineChart(
        TimelinePoint[] Points,
        string Line,
        string TopLabel,
        string MiddleLabel,
        string BottomLabel,
        string StartTime,
        string EndTime);
}
