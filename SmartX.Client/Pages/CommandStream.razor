@inject SmartX.Client.Services.CommandDashboardState DashboardState
@page "/command-stream"
@using SmartX.Shared.Models
@using SmartX.Shared.Requests
@inject HttpClient Http
@implements IAsyncDisposable

<PageTitle>Command Stream | Smart-X</PageTitle>

<div class="container py-4">
    <h1>Real-Time Command Stream and History</h1>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-info" role="status">
            @message
        </div>
    }

    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Device controls</h2>

            <label for="device" class="form-label">Select a device</label>

            <select id="device"
                    class="form-select mb-3"
                    disabled="@isBusy"
                    @bind="selectedSensorId">
                <option value="@Guid.Empty">Choose a device</option>

                @foreach (var device in devices)
                {
                    <option value="@device.Id">
                        @device.DeviceIdentifier
                    </option>
                }
            </select>

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-success"
                        disabled="@(isBusy || selectedSensorId == Guid.Empty)"
                        @onclick="() => SendCommandAsync(true)">
                    Turn on
                </button>

                <button class="btn btn-danger"
                        disabled="@(isBusy || selectedSensorId == Guid.Empty)"
                        @onclick="() => SendCommandAsync(false)">
                    Turn off
                </button>

                <button class="btn btn-warning"
                        disabled="@(isBusy || !CanUndo)"
                        @onclick="UndoAsync">
                    Undo last command
                </button>

                <button class="btn btn-outline-primary"
                        disabled="@isBusy"
                        @onclick="RefreshAsync">
                    Refresh
                </button>
            </div>

            <p class="text-secondary mt-3 mb-0">
                Undo restores the latest command across all devices.
            </p>
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Live devices</h2>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="deviceSearch" class="form-label">
                        Search devices
                    </label>

                    <input id="deviceSearch"
                           class="form-control"
                           placeholder="Device name or location"
                           @bind="searchText"
                           @bind:event="oninput" />
                </div>

                <div class="col-md-3">
                    <label for="categoryFilter" class="form-label">
                        Category
                    </label>

                    <select id="categoryFilter"
                            class="form-select"
                            @bind="selectedCategory">
                        <option value="">All categories</option>

                        @foreach (var category in Enum.GetValues<SensorCategory>())
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="stateFilter" class="form-label">
                        State
                    </label>

                    <select id="stateFilter"
                            class="form-select"
                            @bind="selectedState">
                        <option value="">All states</option>
                        <option value="Normal">Normal</option>
                        <option value="Warning">Warning</option>
                        <option value="Stale">Stale</option>
                        <option value="No data">No data</option>
                    </select>
                </div>
            </div>

            @{
                var visibleSensors = FilteredSensors.ToArray();
            }

            <p class="text-secondary">
                Showing @visibleSensors.Length of @sensorStatuses.Length devices
            </p>

            @if (visibleSensors.Length == 0)
            {
                <p>No devices match these filters.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Device</th>
                                <th scope="col">Location</th>
                                <th scope="col">Latest reading</th>
                                <th scope="col">State</th>
                                <th scope="col">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sensor in visibleSensors)
                            {
                                <tr @key="sensor.SensorId">
                                    <td>
                                        <a href="@($"sensors/{sensor.SensorId}/telemetry")">
                                            @sensor.DeviceIdentifier
                                        </a>
                                    </td>
                                    <td>@sensor.DeploymentLocation</td>
                                    <td>@sensor.LatestValue</td>
                                    <td>@sensor.State</td>
                                    <td>@sensor.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Active alerts (@alerts.Length)</h2>

            <p class="text-secondary">
                Alerts and command history refresh every 5 seconds.
            </p>

            @if (alerts.Length == 0)
            {
                <p>No active alerts in the loaded data.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Device</th>
                                <th scope="col">State</th>
                                <th scope="col">Details</th>
                                <th scope="col">First detected (UTC)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in alerts)
                            {
                                <tr @key="(alert.SensorId, alert.State)">
                                    <td>@alert.DeviceIdentifier</td>
                                    <td>
                                        <span class="badge @(alert.State == "Warning" ? "text-bg-danger" : "text-bg-warning")">
                                            @alert.State
                                        </span>
                                    </td>
                                    <td>@alert.Message</td>
                                    <td>
                                        @alert.FirstDetectedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <h2 class="h5">Command history</h2>

    @if (isBusy)
    {
        <p role="status">Updating...</p>
    }

    @if (history.Length == 0)
    {
        <p>No commands recorded yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Device</th>
                        <th scope="col">Previous state</th>
                        <th scope="col">New state</th>
                        <th scope="col">Time (UTC)</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var command in history)
                    {
                        <tr @key="command.Id">
                            <td>@DeviceName(command.SensorId)</td>
                            <td>@StateName(command.PreviousState)</td>
                            <td>@StateName(command.RequestedState)</td>
                            <td>
                                @command.IssuedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                            </td>
                            <td>
                                @(command.UndoneAtUtc.HasValue ? "Undone" : "Applied")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private SensorProfile[] devices = [];
    private DeviceCommand[] history = [];
    private bool isBusy;
    private string? message;
    private DeviceAlert[] alerts = [];
    private readonly CancellationTokenSource lifetime = new();
    private Task? pollingTask;
    private Dictionary<Guid, SensorProfile> deviceLookup = new();
    private SensorMonitorStatus[] sensorStatuses = [];
    private Guid selectedSensorId
    {
        get => DashboardState.SelectedSensorId;
        set => DashboardState.SelectedSensorId = value;
    }

    private string searchText
    {
        get => DashboardState.SearchText;
        set => DashboardState.SearchText = value;
    }

    private SensorCategory? selectedCategory
    {
        get => DashboardState.SelectedCategory;
        set => DashboardState.SelectedCategory = value;
    }

    private string selectedState
    {
        get => DashboardState.SelectedState;
        set => DashboardState.SelectedState = value;
    }
    private IEnumerable<SensorMonitorStatus> FilteredSensors =>
    sensorStatuses.Where(sensor =>
        (string.IsNullOrWhiteSpace(searchText) ||
            sensor.DeviceIdentifier.Contains(
                searchText.Trim(),
                StringComparison.OrdinalIgnoreCase) ||
            sensor.DeploymentLocation.Contains(
                searchText.Trim(),
                StringComparison.OrdinalIgnoreCase)) &&
        (!selectedCategory.HasValue ||
            deviceLookup.TryGetValue(sensor.SensorId, out var profile) &&
            profile.Category == selectedCategory.Value) &&
        (selectedState.Length == 0 ||
            sensor.State == selectedState));

    private bool CanUndo =>
        history.Any(command => command.UndoneAtUtc is null);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        if (!lifetime.IsCancellationRequested)
        {
            pollingTask = PollAsync();
        }
    }
    private Task RefreshAsync()
    {
        return RunAsync(LoadAsync);
    }

    private async Task LoadAsync()
    {
        var sensors = await Http.GetFromJsonAsync<SensorProfile[]>(
            "api/sensors",
            lifetime.Token) ?? [];

        var loadedHistory = await Http.GetFromJsonAsync<DeviceCommand[]>(
            "api/commands",
            lifetime.Token) ?? [];

        var loadedAlerts = await Http.GetFromJsonAsync<DeviceAlert[]>(
            "api/alerts",
            lifetime.Token) ?? [];

        var monitoring = await Http.GetFromJsonAsync<MonitoringSnapshot>(
            "api/monitoring",
            lifetime.Token);

        deviceLookup = sensors.ToDictionary(sensor => sensor.Id);

        devices = sensors
            .Where(sensor =>
                sensor.Category == SensorCategory.Actuator &&
                sensor.DataType == TelemetryDataType.Boolean)
            .ToArray();

        sensorStatuses = monitoring?.Sensors.ToArray() ?? [];
        history = loadedHistory;
        alerts = loadedAlerts;
    }

    private Task SendCommandAsync(bool state)
    {
        return RunAsync(async () =>
        {
            var request = new IssueCommandRequest
            {
                RequestedState = state
            };

            using var response = await Http.PostAsJsonAsync(
                $"api/commands/{selectedSensorId}",
                request);

            if (!response.IsSuccessStatusCode)
            {
                message =
                    "Command rejected. The device needs an initial reading and must be changing state.";
                return;
            }

            await LoadAsync();
            message = $"Device turned {StateName(state).ToLowerInvariant()}.";
        });
    }

    private Task UndoAsync()
    {
        return RunAsync(async () =>
        {
            using var response = await Http.PostAsync(
                "api/commands/undo",
                null);

            if (!response.IsSuccessStatusCode)
            {
                message = "Could not undo the command. Refresh the history.";
                return;
            }

            await LoadAsync();
            message = "Last command undone.";
        });
    }

    private string DeviceName(Guid sensorId)
    {
        return deviceLookup.TryGetValue(sensorId, out var device)
            ? device.DeviceIdentifier
            : sensorId.ToString();
    }

    private static string StateName(bool state)
    {
        return state ? "On" : "Off";
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();

                    if (!lifetime.IsCancellationRequested)
                    {
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException)
            when (lifetime.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        lifetime.Cancel();

        if (pollingTask is not null)
        {
            await pollingTask;
        }

        lifetime.Dispose();
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (isBusy || lifetime.IsCancellationRequested)
        {
            return;
        }

        isBusy = true;
        message = null;

        try
        {
            await action();
        }
        catch (HttpRequestException)
        {
            message = "Connection failed. Check the API and refresh before retrying.";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (OperationCanceledException)
        {
            message = "Request timed out. Refresh before retrying.";
        }
        catch (System.Text.Json.JsonException)
        {
            message = "Could not read the API response.";
        }
        finally
        {
            isBusy = false;
        }
    }

  
}