
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<section class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Sensor Failure Simulation</h2>

        <p class="text-secondary">
            Simulate a sensor failure or restore an offline sensor.
            Smart-X will automatically recalculate network connectivity
            and available routes.
        </p>

        <div class="mb-3">
            <label for="failureSensor"
                   class="form-label fw-semibold">
                Sensor Identifier
            </label>

            <input id="failureSensor"
                   type="text"
                   class="form-control"
                   list="failureSensorOptions"
                   placeholder="Enter or select a sensor identifier"
                   @bind="selectedSensor" />

            <datalist id="failureSensorOptions">
                @foreach (var id in SensorIds.OrderBy(
                    id => id,
                    StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@id"></option>
                }
            </datalist>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="button"
                    class="btn btn-outline-primary"
                    disabled="@isWorking"
                    @onclick="CheckStatusAsync">
                Check Status
            </button>

            <button type="button"
                    class="btn btn-danger"
                    disabled="@isWorking"
                    @onclick="() => SetAvailabilityAsync(false)">
                Take Sensor Offline
            </button>

            <button type="button"
                    class="btn btn-success"
                    disabled="@isWorking"
                    @onclick="() => SetAvailabilityAsync(true)">
                Restore Sensor Online
            </button>
        </div>

        @if (isWorking)
        {
            <p class="text-secondary mt-3">
                Processing sensor request...
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success mt-3" role="status">
                @successMessage
            </div>
        }

        @if (status is not null &&
            string.Equals(
                status.Id,
                selectedSensor.Trim(),
                StringComparison.OrdinalIgnoreCase))
        {
            <div class="border rounded p-3 mt-3">
                <h3 class="h6">Current Sensor Status</h3>

                <p class="mb-2">
                    <strong>Identifier:</strong>
                    @status.Id
                </p>

                <p class="mb-2">
                    <strong>Availability:</strong>

                    <span class="badge @(status.IsOnline ? "bg-success" : "bg-danger")">
                        @(status.IsOnline ? "Online" : "Offline")
                    </span>
                </p>

                <p class="mb-0">
                    <strong>Gateway Connectivity:</strong>

                    <span class="badge @(status.IsReachable ? "bg-success" : "bg-warning text-dark")">
                        @(status.IsReachable ? "Reachable" : "Unreachable")
                    </span>
                </p>
            </div>
        }

        <p class="small text-secondary mt-3 mb-0">
            Simulated failures do not permanently remove sensors
            or their configured connections.
        </p>
    </div>
</section>

@code {
    [Parameter]
    public string[] SensorIds { get; set; } = [];

    [Parameter]
    public EventCallback OnAvailabilityChanged { get; set; }

    private string selectedSensor = string.Empty;
    private string? errorMessage;
    private string? successMessage;

    private bool isWorking;

    private SensorStatus? status;

    private bool ValidateSensor()
    {
        errorMessage = null;
        successMessage = null;
        status = null;

        if (string.IsNullOrWhiteSpace(selectedSensor))
        {
            errorMessage = "Select a sensor first.";
            return false;
        }

        if (!SensorIds.Contains(
            selectedSensor.Trim(),
            StringComparer.OrdinalIgnoreCase))
        {
            errorMessage = "Select a valid registered sensor.";
            return false;
        }

        return true;
    }

    private async Task CheckStatusAsync()
    {
        if (isWorking || !ValidateSensor())
        {
            return;
        }

        isWorking = true;

        try
        {
            var topology = await Http.GetFromJsonAsync<TopologyStatusResponse>(
                "api/mesh/topology");

            status = topology?.Nodes.FirstOrDefault(node =>
                string.Equals(
                    node.Id,
                    selectedSensor.Trim(),
                    StringComparison.OrdinalIgnoreCase));

            if (status is null)
            {
                errorMessage = "Sensor status could not be found.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to connect to the Smart-X API.";
        }
        catch (OperationCanceledException)
        {
            errorMessage = "The request timed out.";
        }
        catch (JsonException)
        {
            errorMessage = "The API returned invalid sensor information.";
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task SetAvailabilityAsync(bool isOnline)
    {
        if (isWorking || !ValidateSensor())
        {
            return;
        }

        isWorking = true;

        try
        {
            var request = new
            {
                SensorId = selectedSensor.Trim(),
                IsOnline = isOnline
            };

            using var response = await Http.PostAsJsonAsync(
                "api/mesh/sensors/availability",
                request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    $"Unable to update sensor availability. HTTP {(int)response.StatusCode}.";
                return;
            }

            var topology = await response.Content
                .ReadFromJsonAsync<TopologyStatusResponse>();

            status = topology?.Nodes.FirstOrDefault(node =>
                string.Equals(
                    node.Id,
                    selectedSensor.Trim(),
                    StringComparison.OrdinalIgnoreCase));

            successMessage = isOnline
                ? "Sensor restored. Network routes have been recalculated."
                : "Sensor taken offline. Network routes have been recalculated.";

            await OnAvailabilityChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to connect to the Smart-X API.";
        }
        catch (OperationCanceledException)
        {
            errorMessage = "The request timed out.";
        }
        catch (JsonException)
        {
            errorMessage = "The API returned invalid sensor information.";
        }
        finally
        {
            isWorking = false;
        }
    }

    private sealed class TopologyStatusResponse
    {
        public SensorStatus[] Nodes { get; set; } = [];
    }

    private sealed class SensorStatus
    {
        public string Id { get; set; } = string.Empty;
        public bool IsOnline { get; set; }
        public bool IsReachable { get; set; }
    }
}
